<ContentPage BackgroundColor="LavenderBlush"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CinemaManager.MAUI.SessionDetailsPage"
             Title="Деталі Сеансу">

    <VerticalStackLayout Padding="20" Spacing="15">
        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                           Color="RoyalBlue" HorizontalOptions="Center" />

        <Label Text="Інформація про кіносеанс:" FontSize="20" FontAttributes="Bold" />

        <Frame Padding="20" BorderColor="LightGray" CornerRadius="12" BackgroundColor="White">
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding SessionDetails.MovieTitle}" FontSize="26" TextColor="Blue"
                       FontAttributes="Bold" HorizontalOptions="Center" />

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Жанр:" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding SessionDetails.Genre}" FontSize="16" TextColor="DarkSlateGray" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Рік випуску:" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding SessionDetails.ReleaseYear}" FontSize="16" TextColor="DarkSlateGray" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Початок:" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding SessionDetails.StartTime, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                           FontSize="16" TextColor="DarkSlateGray" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Label Text="Тривалість:" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding SessionDetails.DurationMinutes, StringFormat='{0} хвилин'}"
                           FontSize="16" TextColor="DarkSlateGray" />
                </HorizontalStackLayout>

                <Button Text="✏️ Редагувати" Command="{Binding EditCommand}"
                        BackgroundColor="RoyalBlue" TextColor="White" CornerRadius="8" />
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>