<ContentPage BackgroundColor="LavenderBlush"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CinemaManager.MAUI.HallDetailsPage"
             Title="Деталі Залу">

    <Grid Padding="20" RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,10">
            <Label Text="{Binding HallDetails.Name}" FontSize="24" TextColor="Blue" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="15" Margin="0,0,0,10">
                <Label Text="{Binding HallDetails.HallType, StringFormat='Тип: {0}'}" FontSize="16" TextColor="DarkSlateGray" FontAttributes="Bold" />
                <Label Text="{Binding HallDetails.TotalSeats, StringFormat='Кількість місць: {0}'}" FontSize="16" />
            </HorizontalStackLayout>
            <Label Text="Кіносеанси:" FontSize="20" FontAttributes="Bold" />
            <Label Text="{Binding TotalDuration, StringFormat='Загальна тривалість: {0} хв'}" FontSize="14" TextColor="DarkGreen" />
        </VerticalStackLayout>

        <CollectionView x:Name="SessionsCollection" 
                Grid.Row="1"
                SelectionMode="Single"
                ItemsSource="{Binding HallDetails.Sessions}"
                SelectedItem="{Binding SelectedSession}"
                SelectionChangedCommand="{Binding SessionSelectedCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="15" BorderColor="LightGray" CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding MovieTitle}" FontSize="16" TextColor="RoyalBlue" FontAttributes="Bold"/>
                            <Label Text="{Binding Genre, StringFormat='Жанр: {0}'}"/>
                            <Label Text="{Binding StartTime, StringFormat='Початок: {0:HH:mm}'}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>