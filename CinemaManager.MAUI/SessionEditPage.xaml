<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="LavenderBlush"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CinemaManager.MAUI.SessionEditPage"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}"
                               Color="RoyalBlue" HorizontalOptions="Center" />

            <Label Text="Назва фільму:" FontAttributes="Bold" />
            <Entry Text="{Binding MovieTitle}" Placeholder="Введіть назву..." />

            <Label Text="Жанр:" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre}" />

            <Label Text="Рік випуску:" FontAttributes="Bold" />
            <Entry Text="{Binding ReleaseYear}" Keyboard="Numeric" />

            <Label Text="Дата:" FontAttributes="Bold" />
            <DatePicker Date="{Binding StartDate}" />

            <Label Text="Час початку:" FontAttributes="Bold" />
            <TimePicker Time="{Binding StartTimeOfDay}" />

            <Label Text="Тривалість (хв):" FontAttributes="Bold" />
            <Entry Text="{Binding DurationMinutes}" Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center" Margin="0,20,0,0">
                <Button Text="Зберегти" Command="{Binding SaveCommand}"
                        BackgroundColor="RoyalBlue" TextColor="White" CornerRadius="8"
                        WidthRequest="140" />
                <Button Text="Скасувати" Command="{Binding CancelCommand}"
                        BackgroundColor="LightGray" CornerRadius="8"
                        WidthRequest="140" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>